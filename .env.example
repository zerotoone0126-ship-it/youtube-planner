# .env.example
#
# 실제 값은 절대 여기(또는 git)에 넣지 마세요. 로컬 개발용으로 이 파일을
# .env.local로 복사한 뒤 실제 값을 채워 넣으세요. .env.local은 git에 커밋되지
# 않아야 합니다(레포에 .gitignore가 .env*를 아직 무시하지 않고 있다면 반드시
# 추가하세요 — STEP 4-3A 조사 중 발견한 별도 이슈입니다).
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY는 의도적으로 이 파일에 없습니다. Next.js 앱
#    (이 저장소의 app/, lib/)은 service_role을 전혀 쓰지 않습니다 — 모든 쓰기는
#    사용자 세션 + SECURITY DEFINER RPC로 이루어집니다. service_role은 오직
#    worker/ 아래의 Python worker(별도 Cloud Run Job 컨테이너, 이 앱과 같은
#    프로세스/배포가 아님)에서만 필요하며, 그쪽 환경변수는 worker/.env.example을
#    따로 참고하세요.

# --- Supabase (기존, STEP 1 이후 사용 중) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# staging에서만 true로 켜는 디버그 훅(components/upload/video-upload.tsx 참고).
# production에서는 반드시 비워두거나 false로 두세요.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=

# --- GCP / Cloud Tasks (STEP 4-3A 신규, lib/gcp/cloud-tasks.ts에서 사용) ---
#
# Cloud Tasks 큐가 속한 GCP 프로젝트 ID. staging과 production이 서로 다른 GCP
# 프로젝트를 쓴다면 배포 환경별로 다른 값이 들어갑니다.
GCP_PROJECT_ID=

# Cloud Tasks 큐와 Cloud Run Job이 위치한 region (예: asia-northeast3).
GCP_LOCATION=

# Cloud Tasks 큐 이름(리소스 ID만, 전체 경로 아님).
GCP_CLOUD_TASKS_QUEUE=

# 실행할 Cloud Run Job 이름(리소스 ID만). Cloud Tasks의 HTTP target이
# `https://run.googleapis.com/v2/projects/{GCP_PROJECT_ID}/locations/{GCP_LOCATION}/jobs/{GCP_CLOUD_RUN_JOB}:run`
# 을 향하도록 이 값으로 URL을 만듭니다(lib/gcp/cloud-tasks.ts의
# buildCloudRunJobsRunUrl 참고).
GCP_CLOUD_RUN_JOB=

# Cloud Tasks가 jobs.run 호출에 사용할 OAuth 토큰의 주체가 되는 서비스 계정
# 이메일. 이 서비스 계정은 대상 Cloud Run Job에 대해 run.jobs.run 권한(예:
# roles/run.jobsExecutorWithOverrides)이 있어야 합니다. OIDC가
# 아니라 OAuth 토큰을 씁니다 — jobs.run은 Cloud Run 서비스 호출용 엔드포인트가
# 아니라 Cloud Run Admin API 엔드포인트이기 때문입니다.
GCP_TASKS_OAUTH_SERVICE_ACCOUNT_EMAIL=

# 로컬 개발에서만 필요합니다(Application Default Credentials). `gcloud auth
# application-default login`을 실행했다면 보통 이 변수 없이도 ADC가 자동으로
# 잡힙니다 — 그 경우 비워두세요. 배포된 Cloud Run/Vercel 등에서는 설정하지
# 마세요(각 플랫폼이 자체적으로 자격증명을 제공합니다). 이 파일에 실제 JSON
# 키 경로를 커밋하지 마세요 — 파일 자체가 credential이므로 로컬에서만 개인
# 경로로 지정합니다.
GOOGLE_APPLICATION_CREDENTIALS=
