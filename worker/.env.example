# worker/.env.example
#
# 이 파일은 Next.js 앱의 .env.example과 별개입니다 — worker는 별도의 Cloud
# Run Job 컨테이너로 배포되는 독립 프로세스입니다. 실제 값은 여기에도, git
# 에도 절대 넣지 마세요.
#
# ⚠️ SUPABASE_SERVICE_ROLE_KEY는 이 worker에서만 필요합니다(Next.js 앱은
#    쓰지 않습니다 — 루트 .env.example의 설명 참고). 이 값이 배포된 Cloud
#    Run Job 컨테이너 밖으로(로그, 커밋, 다른 서비스 응답 등) 절대 나가지
#    않게 하세요. Secret Manager로 주입하고, 컨테이너 환경변수로 평문 값을
#    직접 넣는 배포 방식은 피하는 것을 권장합니다.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloud Tasks가 task 생성 시 overrides.containerOverrides[].env로 주입합니다
# (lib/gcp/cloud-tasks.ts 참고) — 사람이 배포 설정에 직접 넣는 값이 아닙니다.
# 로컬에서 worker/main.py를 직접 실행해볼 때만 수동으로 채우세요.
ANALYSIS_ID=

# --- 아래는 Cloud Run Job이 실행 컨테이너에 자동으로 주입하는 값들입니다 ---
# 실제 배포 환경에서는 사람이 설정하지 않습니다. 로컬에서 worker/main.py를
# 직접 실행해 오케스트레이션 로직을 눈으로 확인해보고 싶을 때만 흉내내어
# 채우세요(예: CLOUD_RUN_JOB=video-analysis-worker-local,
# CLOUD_RUN_EXECUTION=local-test-1, CLOUD_RUN_TASK_ATTEMPT=0).
CLOUD_RUN_JOB=
CLOUD_RUN_EXECUTION=
CLOUD_RUN_TASK_ATTEMPT=

# 선택. 비워두면 worker/main.py의 DEFAULT_MAX_RETRIES(=1)를 씁니다. Cloud Run
# Job의 실제 --max-retries 배포 설정과 반드시 맞춰야 "마지막 attempt인가"
# 판단이 정확합니다(worker/main.py 상단 주석 참고).
CLOUD_RUN_TASK_MAX_RETRIES=
